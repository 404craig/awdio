# Where uploads, parsed documents, audio cache and the database live
AWDIO_DATA_DIR=./data
# Optional: gate the whole app behind one PIN (4-8 digits). Leave unset for open guest access.
#AWDIO_ACCESS_PIN=
# Optional: seed an ElevenLabs API key (can also be entered in Settings)
#ELEVENLABS_API_KEY=
# wav (default, zero deps) or mp3 (needs ffmpeg on PATH; ~10x smaller cache)
AWDIO_AUDIO_FORMAT=wav
